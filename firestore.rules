rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de ayuda para ver si el usuario está logueado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Obtener el perfil del usuario autenticado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Verificar si el usuario es un administrador
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    // Verificar si el usuario es un miembro aprobado
    function isApprovedMember() {
      return isAuthenticated() && getUserData().role == 'member' && getUserData().approved == true;
    }

    // Reglas para usuarios (perfiles)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.role == 'member' && request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }

    // Reglas para las comunidades
    match /communities/{communityId} {
      // Público general puede leer las aprobadas; miembros aprobados y admins leen todas.
      allow read: if resource.data.approved == true || isAdmin() || (isAuthenticated() && resource.data.createdByUser == request.auth.uid);
      
      // Crear comunidad: Miembros aprobados pueden crear con estado "approved = false"
      allow create: if isApprovedMember() && request.resource.data.approved == false && request.resource.data.createdByUser == request.auth.uid;
      
      // Actualizar: El dueño puede editarla antes de ser aprobada, el admin puede editar todo
      allow update: if isAdmin() || (isApprovedMember() && resource.data.createdByUser == request.auth.uid && resource.data.approved == false);
      
      // Eliminar: Solo administradores
      allow delete: if isAdmin();
    }
  }
}
